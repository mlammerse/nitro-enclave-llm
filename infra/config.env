# Shared, NON-SECRET configuration. Sourced by all infra scripts.
# Secrets (HF token, AWS keys) never live here — see docs/runbook.md.

# --- AWS ---
export AWS_REGION="ap-southeast-2"          # Sydney
export PROJECT="nitro-llm"
export INSTANCE_TYPE="c6i.2xlarge"          # 8 vCPU / 16 GiB, Nitro, enclave-capable
                                            # cheaper fallback: c6i.xlarge (4 vCPU / 8 GiB)
export VOLUME_GB="30"                        # gp3 root volume
export KEY_NAME="${PROJECT}-key"             # break-glass SSH key (SSM is the primary path)
export ROLE_NAME="${PROJECT}-ssm-role"
export PROFILE_NAME="${PROJECT}-ssm-profile"
export SG_NAME="${PROJECT}-sg"

# --- Enclave resource allocation (must be <= what allocator.yaml reserves) ---
export ENCLAVE_CID="16"                      # vsock context id for the enclave
export ENCLAVE_CPUS="4"
export ENCLAVE_MEM_MIB="8192"
export VSOCK_PORT="5000"                     # enclave inference listener
export LISTEN_PORT="8080"                    # parent-side TCP bridge

# --- Model (open-weights GGUF) ---
# Default: Llama 3.2 3B Instruct Q4 (GATED on HF — accept license + set HF_TOKEN).
export MODEL_REPO="bartowski/Llama-3.2-3B-Instruct-GGUF"
export MODEL_FILE="Llama-3.2-3B-Instruct-Q4_K_M.gguf"
# Ungated fallback (Apache-2.0, no token needed): uncomment to swap.
# export MODEL_REPO="Qwen/Qwen2.5-3B-Instruct-GGUF"
# export MODEL_FILE="qwen2.5-3b-instruct-q4_k_m.gguf"
